# WakeWise environment. Copy to server/.env.local (ignored by git). Never commit real keys.

# ---- Server (server/). Never put these in the app. ----
# Required: the server refuses to start without it.
WAKEWISE_API_TOKEN=
# Required for speech to text. Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. gpt-transcribe is OpenAI's recommended transcription model.
# Do not use gpt-4o-mini-transcribe for new work: OpenAI lists it for shutdown on 2027-02-26.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Rail departures (National Rail LDBWS). Basic auth: the username comes with your licence approval.
# NATIONAL_RAIL_USERNAME=
# NATIONAL_RAIL_DARWIN_TOKEN=
# PORT=8787

# ---- App (public: anything EXPO_PUBLIC_ is bundled into the app and visible to users) ----
# Address of the WakeWise server. Leave unset to use typed entry only.
# EXPO_PUBLIC_WAKEWISE_API_URL=https://your-server.example
# A token in the app bundle is NOT a secret. It only deters casual use until accounts exist.
# EXPO_PUBLIC_WAKEWISE_API_TOKEN=
