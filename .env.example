# WakeWise environment. Copy to server/.env.local (ignored by git). Never commit real keys.

# ---- Server (server/). Never put these in the app. ----
# Required: the server refuses to start without it.
WAKEWISE_API_TOKEN=
# Required for speech to text. Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. gpt-transcribe is OpenAI's recommended transcription model.
# Do not use gpt-4o-mini-transcribe for new work: OpenAI lists it for shutdown on 2027-02-26.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Rail departures (National Rail LDBWS). Basic auth: the username comes with your licence approval.
# NATIONAL_RAIL_USERNAME=
# NATIONAL_RAIL_DARWIN_TOKEN=
# Weather (Apple WeatherKit REST API). Team ID is in your Apple Developer membership details.
# The Services ID and Key ID are identifiers, not secrets. The .p8 file is the secret: keep it out of git
# (*.p8 is ignored) and point to it by path, for example server/secrets/AuthKey_XXXXXXXXXX.p8
# WEATHERKIT_TEAM_ID=
# WEATHERKIT_SERVICE_ID=
# WEATHERKIT_KEY_ID=
# WEATHERKIT_PRIVATE_KEY_PATH=
# Overnight journey watching. DATABASE_URL is the pooled connection string from Neon. The APNs key is a key with the
# "Apple Push Notifications service" capability from your Apple Developer account (Keys), the same Team ID as above.
# On a host with no files, set the *_BASE64 value (base64 of the .p8 file) instead of the path.
# DATABASE_URL=
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY_PATH=server/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_PRIVATE_KEY_BASE64=
# APNS_TOPIC=com.dailytaskapps.wakewise
# WEATHERKIT_PRIVATE_KEY_BASE64=
# PORT=8787

# ---- App (public: anything EXPO_PUBLIC_ is bundled into the app and visible to users) ----
# Address of the WakeWise server. Leave unset to use typed entry only.
# EXPO_PUBLIC_WAKEWISE_API_URL=https://your-server.example
# A token in the app bundle is NOT a secret. It only deters casual use until accounts exist.
# EXPO_PUBLIC_WAKEWISE_API_TOKEN=
